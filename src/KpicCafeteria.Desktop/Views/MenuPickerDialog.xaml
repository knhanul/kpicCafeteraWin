<Window x:Class="KpicCafeteria.Desktop.Views.MenuPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="메뉴 선택" Height="560" Width="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontFamily}" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Style="{StaticResource StandardTextBox}" Width="180" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="메뉴명 검색"/>
            <ComboBox Style="{StaticResource StandardComboBox}" Width="120" Margin="8,0,0,0" ItemsSource="{Binding MenuRoles}" SelectedItem="{Binding RoleFilter}" ToolTip="역할 필터"/>
            <TextBlock Text="검색 결과가 200건을 초과하면 검색어를 입력해 주세요." Style="{StaticResource CaptionText}" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  Style="{StaticResource FlatDataGrid}"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  SelectionMode="Single"
                  ColumnHeaderStyle="{StaticResource FlatDataGridColumnHeader}"
                  CellStyle="{StaticResource FlatDataGridCell}"
                  RowStyle="{StaticResource FlatDataGridRow}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="선택" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="메뉴명" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="역할" Binding="{Binding Role}" IsReadOnly="True" Width="80"/>
                <DataGridTemplateColumn Header="레시피" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource StandardComboBox}" ItemsSource="{Binding Recipes}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedRecipeId, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsSelected}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" IsReadOnly="True" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="추가" Margin="0,0,8,0" Click="OnConfirm"/>
            <Button Style="{StaticResource SecondaryButton}" Content="취소" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

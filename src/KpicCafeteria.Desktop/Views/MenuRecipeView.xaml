<UserControl x:Class="KpicCafeteria.Desktop.Views.MenuRecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KpicCafeteria.Desktop.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:NullToVisibilityConverter x:Key="NullToVis"/>
        <vm:NullToCollapsedVisibilityConverter x:Key="NullToCollapsedVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorder}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewMenuCommand}" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconPlus}" Margin="0,0,6,0" Stroke="White"/>
                        <TextBlock Text="새 메뉴"/>
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource PageTitleText}" Text="메뉴 / 레시피"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ===== Main Content: Master List + Detail ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Master List ===== -->
            <Border Grid.Column="0" Style="{StaticResource MasterListContainer}">
                <DockPanel>
                    <!-- Search -->
                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                        <TextBox Style="{StaticResource StandardTextBox}"
                                 Text="{Binding MenuSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="메뉴명 검색"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ComboBox Style="{StaticResource StandardComboBox}" Width="130"
                                      ItemsSource="{Binding MenuRoles}"
                                      SelectedItem="{Binding MenuRoleFilter}"
                                      ToolTip="역할 필터"/>
                            <CheckBox Style="{StaticResource StandardCheckBox}" Content="미사용 포함"
                                      IsChecked="{Binding ShowInactive}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Menu List -->
                    <ListBox ItemsSource="{Binding Menus}" SelectedItem="{Binding SelectedMenu}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource MasterListItem}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}"/>
                                    <TextBlock Text="{Binding Role}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== Detail Panel ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Detail Content (scrollable) -->
                <ScrollViewer Grid.Row="0" Style="{StaticResource ThinScrollViewer}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,16">

                        <!-- Empty state when no menu selected -->
                        <StackPanel Visibility="{Binding SelectedMenu, Converter={StaticResource NullToCollapsedVis}}">
                            <TextBlock Style="{StaticResource EmptyStateText}" Text="메뉴를 선택하면 상세 정보가 표시됩니다"/>
                        </StackPanel>

                        <!-- Menu detail -->
                        <StackPanel Visibility="{Binding SelectedMenu, Converter={StaticResource NullToVis}}">

                            <!-- Menu name -->
                            <TextBlock Text="{Binding MenuName}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20"/>

                            <!-- Menu Info Section -->
                            <TextBlock Style="{StaticResource EditorSectionHeader}" Text="메뉴 정보"/>
                            <Border Style="{StaticResource DetailSectionBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormFieldLabel}" Text="메뉴명"/>
                                    <TextBox Style="{StaticResource StandardTextBox}"
                                             Text="{Binding MenuName, UpdateSourceTrigger=PropertyChanged}"
                                             MaxWidth="300" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                                    <TextBlock Style="{StaticResource FormFieldLabel}" Text="역할"/>
                                    <ComboBox Style="{StaticResource StandardComboBox}"
                                              ItemsSource="{Binding MenuRoles}"
                                              SelectedItem="{Binding MenuRole}"
                                              MaxWidth="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                                    <TextBlock Style="{StaticResource FormFieldLabel}" Text="통계 집계명"/>
                                    <TextBox Style="{StaticResource StandardTextBox}"
                                             Text="{Binding CanonicalName, UpdateSourceTrigger=PropertyChanged}"
                                             MaxWidth="300" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                                    <CheckBox Style="{StaticResource StandardCheckBox}" Content="사용"
                                              IsChecked="{Binding MenuActive}"/>
                                </StackPanel>
                            </Border>

                            <!-- Recipe Section -->
                            <TextBlock Style="{StaticResource EditorSectionHeader}" Text="레시피"/>
                            <Border Style="{StaticResource DetailSectionBorder}">
                                <DockPanel>
                                    <!-- Recipe list (left) -->
                                    <StackPanel DockPanel.Dock="Left" Width="180" Margin="0,0,16,0">
                                        <ListBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"
                                                 Background="Transparent" BorderThickness="0"
                                                 MaxHeight="200"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource MasterListItem}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource SubtleButton}" Content="+ 레시피"
                                                    Command="{Binding NewRecipeCommand}" Margin="0,0,4,0"/>
                                            <Button Style="{StaticResource SubtleButton}" Content="기본 지정"
                                                    Command="{Binding SetDefaultRecipeCommand}" Margin="4,0,4,0"/>
                                            <Button Style="{StaticResource DestructiveButton}" Content="미사용"
                                                    Command="{Binding ArchiveRecipeCommand}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Recipe editor (right) -->
                                    <StackPanel Visibility="{Binding SelectedRecipe, Converter={StaticResource NullToVis}}">
                                        <TextBlock Style="{StaticResource FormFieldLabel}" Text="레시피명"/>
                                        <TextBox Style="{StaticResource StandardTextBox}"
                                                 Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxWidth="240" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <CheckBox Style="{StaticResource StandardCheckBox}" Content="기본 레시피"
                                                      IsChecked="{Binding RecipeIsDefault}" Margin="0,0,16,0"/>
                                            <CheckBox Style="{StaticResource StandardCheckBox}" Content="사용"
                                                      IsChecked="{Binding RecipeActive}"/>
                                        </StackPanel>

                                        <!-- Recipe ingredients -->
                                        <TextBlock Style="{StaticResource FormFieldLabel}" Text="재료"/>
                                        <DataGrid ItemsSource="{Binding RecipeIngredients}"
                                                  Style="{StaticResource CompactDataGrid}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                  RowHeaderWidth="0" SelectionMode="Single"
                                                  MaxHeight="240"
                                                  ColumnHeaderStyle="{StaticResource FlatDataGridColumnHeader}"
                                                  CellStyle="{StaticResource FlatDataGridCell}"
                                                  RowStyle="{StaticResource FlatDataGridRow}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="재료명" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding IngredientName}" Padding="8,0"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                                                                      ItemsSource="{Binding DataContext.IngredientOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                      DisplayMemberPath="Name"
                                                                      Text="{Binding IngredientName, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="100인 기준" Width="100"
                                                                    Binding="{Binding QuantityPer100, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.###}}">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="Padding" Value="8,0"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="단위" Width="60"
                                                                    Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridCheckBoxColumn Header="주재료" Width="60"
                                                                        Binding="{Binding IsPrimary, UpdateSourceTrigger=PropertyChanged}"/>
                                                <DataGridTemplateColumn Header="" Width="44" CanUserResize="False">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="×" FontSize="14" Padding="4,0"
                                                                    Style="{StaticResource AliasChipClose}"
                                                                    Command="{Binding DataContext.RemoveIngredientRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Button Style="{StaticResource SubtleButton}" Content="+ 재료 추가"
                                                Command="{Binding AddIngredientRowCommand}" Margin="0,8,0,12"
                                                HorizontalAlignment="Left"/>

                                        <TextBlock Style="{StaticResource FormFieldLabel}" Text="비고"/>
                                        <TextBox Style="{StaticResource StandardTextBox}"
                                                 Text="{Binding RecipeNote, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxWidth="400" HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <!-- Recipe empty state -->
                                    <StackPanel VerticalAlignment="Center"
                                                Visibility="{Binding SelectedRecipe, Converter={StaticResource NullToCollapsedVis}}">
                                        <TextBlock Style="{StaticResource EmptyStateText}" Text="레시피를 선택하거나 새로 만드세요"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action Bar (bottom) -->
                <Border Grid.Row="1" Style="{StaticResource DetailActionBar}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveRecipeCommand}" Margin="8,0,0,0"
                                Visibility="{Binding SelectedRecipe, Converter={StaticResource NullToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconSave}" Margin="0,0,6,0" Stroke="White"/>
                                <TextBlock Text="레시피 저장"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveMenuCommand}" Margin="0,0,0,0"
                                Visibility="{Binding SelectedMenu, Converter={StaticResource NullToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconSave}" Margin="0,0,6,0" Stroke="White"/>
                                <TextBlock Text="메뉴 저장"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Left" Style="{StaticResource DestructiveButton}"
                                Command="{Binding ArchiveMenuCommand}" Content="미사용 처리"
                                Visibility="{Binding SelectedMenu, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Style="{StaticResource CaptionText}" Text="변경사항은 저장 시 반영됩니다"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

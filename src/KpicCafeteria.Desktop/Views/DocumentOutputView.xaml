<UserControl x:Class="KpicCafeteria.Desktop.Views.DocumentOutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KpicCafeteria.Desktop.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorder}">
            <TextBlock Style="{StaticResource PageTitleText}" Text="문서 출력"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ===== Main Content: Settings + Status ===== -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16" MaxWidth="700">

                <!-- Document Type Section -->
                <TextBlock Style="{StaticResource EditorSectionHeader}" Text="문서 종류"/>
                <Border Style="{StaticResource OperationSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OperationDescription}"
                                   Text="생성할 문서를 선택하세요."/>
                        <ComboBox Style="{StaticResource StandardComboBox}"
                                  ItemsSource="{Binding DocumentTypes}"
                                  SelectedItem="{Binding SelectedDocumentType}"
                                  MaxWidth="240" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Period Section -->
                <TextBlock Style="{StaticResource EditorSectionHeader}" Text="기간"/>
                <Border Style="{StaticResource OperationSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OperationDescription}"
                                   Text="문서에 포함할 기간을 설정하세요."/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FormFieldLabel}" Text="시작일"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker SelectedDate="{Binding StartDate}" Width="140" Margin="0,0,16,0"/>
                            <TextBlock Style="{StaticResource FormFieldLabel}" Text="종료일"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker SelectedDate="{Binding EndDate}" Width="140"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Generate Section -->
                <TextBlock Style="{StaticResource EditorSectionHeader}" Text="문서 생성"/>
                <Border Style="{StaticResource OperationSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OperationDescription}"
                                   Text="HWPX는 한글에서 수정할 수 있는 문서, PDF는 바로 열람·인쇄할 수 있는 문서입니다."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding GenerateHwpxCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconSave}" Margin="0,0,6,0" Stroke="White"/>
                                    <TextBlock Text="HWPX 저장"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding GeneratePdfCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconSave}" Margin="0,0,6,0" Stroke="White"/>
                                    <TextBlock Text="PDF 저장"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Excel Archive -->
                        <TextBlock Style="{StaticResource FormFieldLabel}" Text="Excel 데이터 아카이브" Margin="0,8,0,4"/>
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="업무 데이터를 확인·보관용 Excel 파일로 저장합니다." Margin="0,0,0,8"/>
                        <Button Style="{StaticResource SubtleButton}"
                                Command="{Binding ExportExcelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconArchive}" Margin="0,0,6,0"/>
                                <TextBlock Text="Excel 아카이브 저장"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Status / Result -->
                <TextBlock Style="{StaticResource EditorSectionHeader}" Text="결과"/>
                <Border Style="{StaticResource OperationSection}">
                    <StackPanel>
                        <!-- Busy indicator -->
                        <Border Style="{StaticResource ProgressPanel}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="처리 중..." Style="{StaticResource BodyText}"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <!-- Result text -->
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

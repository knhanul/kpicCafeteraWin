<UserControl x:Class="KpicCafeteria.Desktop.Views.Statistics.MealStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KpicCafeteria.Desktop.Controls"
             xmlns:views="clr-namespace:KpicCafeteria.Desktop.Views.Statistics"
             xmlns:vm="clr-namespace:KpicCafeteria.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource StatisticsToolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="식수 통계" Style="{StaticResource PageTitleText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <views:StatisticsFilterBar/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Loading State -->
                <StackPanel Grid.Row="0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="통계를 불러오는 중..." Style="{StaticResource StatisticsEmptyState}"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,16"/>
                </StackPanel>

                <!-- KPI Cards -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16"
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <controls:KpiCard Label="운영일수" Value="{Binding ServiceCount}" Sub="기간 내 배식 건수"/>
                    <controls:KpiCard Label="총 계획 식수" Value="{Binding PlannedSum}" Sub="계획 합계"/>
                    <controls:KpiCard Label="총 실제 식수" Value="{Binding ActualSum}" Sub="실제 입력 합계"/>
                    <controls:KpiCard Label="실제 입력률" Value="{Binding InputRate}" Sub="실제 입력 배식 비율"/>
                    <controls:KpiCard Label="계획 대비 편차" Value="{Binding DeviationRate}" Sub="(실제-계획)/계획"/>
                    <controls:KpiCard Label="중식" Value="{Binding LunchSummary}" Sub="실제 / 계획 (편차율)"/>
                    <controls:KpiCard Label="석식" Value="{Binding DinnerSummary}" Sub="실제 / 계획 (편차율)"/>
                </StackPanel>

                <!-- Weekday Average + Monthly Trend -->
                <Grid Grid.Row="1" Margin="0,0,0,16"
                      Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatisticsSection}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="요일별 평균 (월~금)" Style="{StaticResource StatisticsSectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding WeekdayAverages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Weekday}" Style="{StaticResource RankingLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PlannedAverage, StringFormat=계획 {0:N1}}" FontFamily="{StaticResource AppFontFamily}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ActualAverage, StringFormat=실제 {0:N1}}" FontFamily="{StaticResource AppFontFamily}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ActualRecords, StringFormat={}{0}회 입력}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatisticsSection}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="월별 추세" Style="{StaticResource StatisticsSectionTitle}"/>
                            <TextBlock Text="계획" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                            <controls:BarChart ItemsSource="{Binding PlannedTrend}" MinHeight="40" Margin="0,0,0,10"/>
                            <TextBlock Text="실제" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                            <controls:BarChart ItemsSource="{Binding ActualTrend}" MinHeight="40"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Anomalies -->
                <Border Grid.Row="2" Style="{StaticResource StatisticsSection}" Margin="0,0,0,16"
                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="식수 이상치" Style="{StaticResource StatisticsSectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding Anomalies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AnomalyItem}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠" FontSize="12" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy.MM.dd}}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Weekday}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding MealTypeName}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Level}" FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                                                <TextBlock Text="{Binding DeviationRate, StringFormat=계획 대비 {0:+#.#;-#.#;0}%}" Style="{StaticResource AnomalyText}" Margin="0,0,16,0"/>
                                                <TextBlock Text="{Binding UsualDeviationRate, StringFormat=평소 대비 {0:+#.#;-#.#;0}%}" Style="{StaticResource AnomalyText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Backdata -->
                <Border Grid.Row="3" Style="{StaticResource StatisticsSection}"
                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="일별 백데이터" Style="{StaticResource StatisticsSectionTitle}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Text="{Binding BackdataFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Width="240" HorizontalAlignment="Left" Margin="0,0,0,8"
                                     Style="{StaticResource StandardTextBox}"
                                     ToolTip="날짜(yyyy-MM-dd)·구분·요일로 검색"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredBackdata}"
                                      Style="{StaticResource CompactDataGrid}"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="날짜" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                    <DataGridTextColumn Header="요일" Binding="{Binding Weekday}" Width="70"/>
                                    <DataGridTextColumn Header="구분" Binding="{Binding MealTypeName}" Width="60"/>
                                    <DataGridTextColumn Header="계획" Binding="{Binding PlannedCount}" Width="70"/>
                                    <DataGridTextColumn Header="실제" Binding="{Binding ActualCount}" Width="70"/>
                                    <DataGridTextColumn Header="차이" Binding="{Binding Diff}" Width="70"/>
                                    <DataGridTextColumn Header="편차율" Binding="{Binding DeviationRate, StringFormat={}{0:+#.#;-#.#;0}%}" Width="90"/>
                                    <DataGridTextColumn Header="평소 중앙값" Binding="{Binding UsualMedian}" Width="100"/>
                                    <DataGridTextColumn Header="평소 편차" Binding="{Binding UsualDeviationRate, StringFormat={}{0:+#.#;-#.#;0}%}" Width="90"/>
                                    <DataGridTextColumn Header="입력" Binding="{Binding Input}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status Bar -->
                <TextBlock Grid.Row="4" Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                           Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl x:Class="KpicCafeteria.Desktop.Views.Statistics.StatisticsFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="40" d:DesignWidth="800">
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="기간" FontFamily="{StaticResource AppFontFamily}" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox Width="120" Margin="0,0,10,0"
                  Style="{StaticResource StandardComboBox}"
                  ItemsSource="{Binding Period.Presets}"
                  SelectedValuePath="Key" DisplayMemberPath="Label"
                  SelectedValue="{Binding Period.SelectedPreset}"/>
        <TextBlock Text="시작일" FontFamily="{StaticResource AppFontFamily}" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <DatePicker Width="120" Margin="0,0,10,0"
                    Style="{StaticResource StandardDatePicker}"
                    SelectedDate="{Binding Period.StartDate}"/>
        <TextBlock Text="종료일" FontFamily="{StaticResource AppFontFamily}" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <DatePicker Width="120" Margin="0,0,16,0"
                    Style="{StaticResource StandardDatePicker}"
                    SelectedDate="{Binding Period.EndDate}"/>
        <TextBlock Text="식사" FontFamily="{StaticResource AppFontFamily}" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox Width="90"
                  Style="{StaticResource StandardComboBox}"
                  ItemsSource="{Binding MealTypeOptions}"
                  SelectedValuePath="Key" DisplayMemberPath="Label"
                  SelectedValue="{Binding SelectedMealType}"/>
    </StackPanel>
</UserControl>

<UserControl x:Class="KpicCafeteria.Desktop.Views.Statistics.MenuStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KpicCafeteria.Desktop.Controls"
             xmlns:views="clr-namespace:KpicCafeteria.Desktop.Views.Statistics"
             xmlns:vm="clr-namespace:KpicCafeteria.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource StatisticsToolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="메뉴 통계" Style="{StaticResource PageTitleText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <views:StatisticsFilterBar/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Loading State -->
                <StackPanel Grid.Row="0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="통계를 불러오는 중..." Style="{StaticResource StatisticsEmptyState}"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,16"/>
                </StackPanel>

                <!-- Content -->
                <Grid Grid.Row="0"
                      Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- KPI Cards -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <controls:KpiCard Label="고유 메뉴 수" Value="{Binding UniqueMenuCount}" Sub="메뉴 ID + 스냅샷명 기준"/>
                        <controls:KpiCard Label="총 사용 횟수" Value="{Binding TotalUsageCount}" Sub="기간 내 메뉴 행 수"/>
                        <controls:KpiCard Label="신규 메뉴" Value="{Binding NewMenuCount}" Sub="기간 시작 전 사용 이력 없음"/>
                        <controls:KpiCard Label="반복 메뉴" Value="{Binding RepeatMenuCount}" Sub="14일 2회 이상 또는 28일 3회 이상"/>
                        <controls:KpiCard Label="미사용 메뉴" Value="{Binding UnusedMenuCount}" Sub="최근 90일 미사용"/>
                    </StackPanel>

                    <!-- Main Two-Column Area -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340" MinWidth="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Lists -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <!-- Top Menus -->
                            <Border Style="{StaticResource StatisticsSection}">
                                <StackPanel>
                                    <TextBlock Text="자주 제공된 메뉴 (사용 횟수순)" Style="{StaticResource StatisticsSectionTitle}"/>
                                    <DataGrid ItemsSource="{Binding TopMenus}"
                                              Style="{StaticResource CompactDataGrid}"
                                              IsReadOnly="True" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="메뉴명" Binding="{Binding MenuName}" Width="*"/>
                                            <DataGridTextColumn Header="역할" Binding="{Binding Role}" Width="60"/>
                                            <DataGridTextColumn Header="사용" Binding="{Binding UsageCount}" Width="60"/>
                                            <DataGridTextColumn Header="중식" Binding="{Binding LunchCount}" Width="55"/>
                                            <DataGridTextColumn Header="석식" Binding="{Binding DinnerCount}" Width="55"/>
                                            <DataGridTextColumn Header="첫 사용" Binding="{Binding FirstUsed, StringFormat={}{0:yyyy-MM-dd}}" Width="95"/>
                                            <DataGridTextColumn Header="최근" Binding="{Binding LastUsed, StringFormat={}{0:yyyy-MM-dd}}" Width="95"/>
                                            <DataGridTextColumn Header="평균 간격" Binding="{Binding AvgInterval, StringFormat={}{0:N1}일}" Width="80"/>
                                            <DataGridTemplateColumn Header="상세" Width="55">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="보기" Style="{StaticResource SubtleButton}" FontSize="11" Padding="6,2"
                                                                Command="{Binding DataContext.ShowDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Repeated Menus -->
                            <Border Style="{StaticResource StatisticsSection}">
                                <StackPanel>
                                    <TextBlock Text="반복 메뉴" Style="{StaticResource StatisticsSectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding Repeats}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Style="{StaticResource RankingItem}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding MenuName}" Style="{StaticResource RankingLabel}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource AnomalyText}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}{0}회}" Style="{StaticResource RankingValue}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Unused Menus -->
                            <Border Style="{StaticResource StatisticsSection}">
                                <StackPanel>
                                    <TextBlock Text="미사용 메뉴 (최근 90일)" Style="{StaticResource StatisticsSectionTitle}"/>
                                    <DataGrid ItemsSource="{Binding UnusedMenus}"
                                              Style="{StaticResource CompactDataGrid}"
                                              IsReadOnly="True" MaxHeight="180">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="메뉴명" Binding="{Binding MenuName}" Width="*"/>
                                            <DataGridTextColumn Header="마지막 사용" Binding="{Binding LastUsed, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
                                            <DataGridTextColumn Header="경과일" Binding="{Binding DaysSinceLast}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Backdata -->
                            <Border Style="{StaticResource StatisticsSection}">
                                <StackPanel>
                                    <TextBlock Text="백데이터" Style="{StaticResource StatisticsSectionTitle}"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0" Text="{Binding BackdataFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="240" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                 Style="{StaticResource StandardTextBox}"
                                                 ToolTip="날짜(yyyy-MM-dd)·메뉴명·구분으로 검색"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredBackdata}"
                                                  Style="{StaticResource CompactDataGrid}"
                                                  IsReadOnly="True" MaxHeight="250">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="날짜" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                                <DataGridTextColumn Header="요일" Binding="{Binding Weekday}" Width="65"/>
                                                <DataGridTextColumn Header="구분" Binding="{Binding MealTypeName}" Width="55"/>
                                                <DataGridTextColumn Header="역할" Binding="{Binding Role}" Width="55"/>
                                                <DataGridTextColumn Header="메뉴명" Binding="{Binding MenuName}" Width="*"/>
                                                <DataGridTextColumn Header="계획" Binding="{Binding PlannedCount}" Width="60"/>
                                                <DataGridTextColumn Header="실제" Binding="{Binding ActualCount}" Width="60"/>
                                                <DataGridTextColumn Header="이전 사용" Binding="{Binding PreviousUsedDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                                <DataGridTextColumn Header="경과일" Binding="{Binding DaysSincePrevious}" Width="65"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Detail Panel -->
                        <Border Grid.Column="1" Style="{StaticResource DetailPanel}" Margin="8,0,0,0"
                                Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                                    <Button Content="닫기" Style="{StaticResource SubtleButton}" FontSize="11" Padding="8,3" Margin="12,0,0,0"
                                            Command="{Binding CloseDetailCommand}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding DetailSummary}" Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Border Grid.Row="2" Style="{StaticResource StatisticsSection}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="월별 사용" Style="{StaticResource StatisticsSectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding DetailMonthlyUsage}" MaxHeight="120">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Style="{StaticResource RankingItem}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="50"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Month}" Style="{StaticResource RankingLabel}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0}회}" Style="{StaticResource RankingValue}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="3" Style="{StaticResource StatisticsSection}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="최근 이력 (최대 20건)" Style="{StaticResource StatisticsSectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding DetailRecentHistory}" MaxHeight="140">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="45"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="60"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" FontFamily="{StaticResource AppFontFamily}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding MealTypeName}" FontFamily="{StaticResource AppFontFamily}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding PlannedCount, StringFormat=계획 {0}}" FontFamily="{StaticResource AppFontFamily}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding ActualCount, StringFormat=실제 {0}}" FontFamily="{StaticResource AppFontFamily}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="4" Style="{StaticResource StatisticsSection}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="함께 사용된 메뉴" Style="{StaticResource StatisticsSectionTitle}"/>
                                        <ItemsControl ItemsSource="{Binding DetailCoUsed}" MaxHeight="120">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Style="{StaticResource RankingItem}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="50"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding MenuName}" Style="{StaticResource RankingLabel}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0}회}" Style="{StaticResource RankingValue}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="5" Style="{StaticResource StatisticsSection}">
                                    <StackPanel>
                                        <TextBlock Text="사용 이력" Style="{StaticResource StatisticsSectionTitle}"/>
                                        <DataGrid ItemsSource="{Binding DetailBackdata}"
                                                  Style="{StaticResource CompactDataGrid}"
                                                  IsReadOnly="True" MaxHeight="200">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="날짜" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="95"/>
                                                <DataGridTextColumn Header="구분" Binding="{Binding MealTypeName}" Width="50"/>
                                                <DataGridTextColumn Header="계획" Binding="{Binding PlannedCount}" Width="55"/>
                                                <DataGridTextColumn Header="실제" Binding="{Binding ActualCount}" Width="55"/>
                                                <DataGridTextColumn Header="이전 사용" Binding="{Binding PreviousUsedDate, StringFormat={}{0:yyyy-MM-dd}}" Width="95"/>
                                                <DataGridTextColumn Header="경과일" Binding="{Binding DaysSincePrevious}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

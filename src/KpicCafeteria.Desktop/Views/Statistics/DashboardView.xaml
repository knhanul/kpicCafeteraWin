<UserControl x:Class="KpicCafeteria.Desktop.Views.Statistics.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KpicCafeteria.Desktop.Controls"
             xmlns:views="clr-namespace:KpicCafeteria.Desktop.Views.Statistics"
             xmlns:vm="clr-namespace:KpicCafeteria.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: Title + Filter -->
        <Border Grid.Row="0" Style="{StaticResource StatisticsToolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="운영 대시보드" Style="{StaticResource PageTitleText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <views:StatisticsFilterBar/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Loading State -->
                <StackPanel Grid.Row="0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="통계를 불러오는 중..." Style="{StaticResource StatisticsEmptyState}"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,16"/>
                </StackPanel>

                <!-- KPI Cards Row -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16"
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <controls:KpiCard Label="운영일수" Value="{Binding OperatingDays}" Sub="기간 내 배식 건수"/>
                    <controls:KpiCard Label="고유 메뉴 수" Value="{Binding UniqueMenuCount}" Sub="메뉴 ID + 스냅샷명 기준"/>
                    <controls:KpiCard Label="중식" Value="{Binding LunchSummary}" Sub="실제 / 계획 (편차율)"/>
                    <controls:KpiCard Label="석식" Value="{Binding DinnerSummary}" Sub="실제 / 계획 (편차율)"/>
                </StackPanel>

                <!-- Main Two-Column Area -->
                <Grid Grid.Row="1" Margin="0,0,0,16"
                      Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Trends + Rankings -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <!-- Monthly Trend (Planned) -->
                        <Border Style="{StaticResource StatisticsSection}">
                            <StackPanel>
                                <TextBlock Text="월별 식수 추세 (계획)" Style="{StaticResource StatisticsSectionTitle}"/>
                                <controls:BarChart ItemsSource="{Binding PlannedTrend}" MinHeight="60"/>
                            </StackPanel>
                        </Border>

                        <!-- Monthly Trend (Actual) -->
                        <Border Style="{StaticResource StatisticsSection}">
                            <StackPanel>
                                <TextBlock Text="월별 식수 추세 (실제)" Style="{StaticResource StatisticsSectionTitle}"/>
                                <controls:BarChart ItemsSource="{Binding ActualTrend}" MinHeight="60"/>
                            </StackPanel>
                        </Border>

                        <!-- Top Menus -->
                        <Border Style="{StaticResource StatisticsSection}">
                            <StackPanel>
                                <TextBlock Text="자주 사용된 메뉴 (상위 5)" Style="{StaticResource StatisticsSectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding MenuUsage}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Style="{StaticResource RankingItem}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding MenuName}" Style="{StaticResource RankingLabel}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0}회}" Style="{StaticResource RankingValue}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Repeated Menus -->
                        <Border Style="{StaticResource StatisticsSection}">
                            <StackPanel>
                                <TextBlock Text="반복 메뉴 (상위 5)" Style="{StaticResource StatisticsSectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding RepeatedMenus}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Style="{StaticResource RankingItem}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding MenuName}" Style="{StaticResource RankingLabel}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding PeriodCount, StringFormat=기간 {0}회}" Style="{StaticResource RankingValue}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Ingredient Groups -->
                        <Border Style="{StaticResource StatisticsSection}">
                            <StackPanel>
                                <TextBlock Text="재료군 사용량 (상위 6)" Style="{StaticResource StatisticsSectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding IngredientGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Style="{StaticResource RankingItem}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Group}" Style="{StaticResource RankingLabel}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding EstimatedKg, StringFormat={}{0:N1} kg}" Style="{StaticResource RankingValue}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Workflow Summary -->
                        <Border Style="{StaticResource StatisticsSection}">
                            <StackPanel>
                                <TextBlock Text="업무 기록 현황" Style="{StaticResource StatisticsSectionTitle}"/>
                                <TextBlock Text="{Binding WorkflowText}" Style="{StaticResource BodyText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Anomalies -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <!-- Meal Anomalies -->
                        <Border Style="{StaticResource StatisticsSection}">
                            <StackPanel>
                                <TextBlock Text="운영 특이사항 — 식수" Style="{StaticResource StatisticsSectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding MealAnomalies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource AnomalyItem}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconWarning}" Stroke="{StaticResource WarningBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy.MM.dd}}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding MealTypeName}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                                        <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                        <TextBlock Text="{Binding Level}" FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DeviationRate, StringFormat=계획 대비 {0:+#.#;-#.#;0}%}" Style="{StaticResource AnomalyText}" Margin="16,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Menu Repeats -->
                        <Border Style="{StaticResource StatisticsSection}">
                            <StackPanel>
                                <TextBlock Text="운영 특이사항 — 메뉴 반복" Style="{StaticResource StatisticsSectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding MenuRepeats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource AnomalyItem}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconWarning}" Stroke="{StaticResource WarningBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding MenuName}" Style="{StaticResource RankingLabel}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource AnomalyText}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Ingredient Changes -->
                        <Border Style="{StaticResource StatisticsSection}">
                            <StackPanel>
                                <TextBlock Text="운영 특이사항 — 재료 사용량 변화" Style="{StaticResource StatisticsSectionTitle}"/>
                                <TextBlock Text="직전 동일 기간 대비" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding IngredientChanges}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource AnomalyItem}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconWarning}" Stroke="{StaticResource WarningBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Group}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Level}" FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Rate, StringFormat=전기 대비 {0:+#.#;-#.#;0}%}" Style="{StaticResource AnomalyText}" Margin="16,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Record Gaps -->
                        <Border Style="{StaticResource StatisticsSection}">
                            <StackPanel>
                                <TextBlock Text="운영 특이사항 — 기록 누락" Style="{StaticResource StatisticsSectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding RecordGaps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource AnomalyItem}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconWarning}" Stroke="{StaticResource WarningBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy.MM.dd}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource AnomalyText}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Status Bar -->
                <Grid Grid.Row="2"
                      Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="대시보드는 분석 목적 화면입니다. 원본 데이터 수정은 업무 화면에서 가능합니다." Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl x:Class="KpicCafeteria.Desktop.Views.Statistics.OperationsStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KpicCafeteria.Desktop.Controls"
             xmlns:views="clr-namespace:KpicCafeteria.Desktop.Views.Statistics"
             xmlns:vm="clr-namespace:KpicCafeteria.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource StatisticsToolbar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="운영 기록 통계" Style="{StaticResource PageTitleText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <views:StatisticsFilterBar/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Loading State -->
                <StackPanel Grid.Row="0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="통계를 불러오는 중..." Style="{StaticResource StatisticsEmptyState}"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,16"/>
                </StackPanel>

                <!-- KPI Cards -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16"
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <controls:KpiCard Label="배식 건수" Value="{Binding ServiceCount}" Sub="기간 내 배식"/>
                    <controls:KpiCard Label="실제 식수 입력률" Value="{Binding ActualInputRate}" Sub="실제 입력 배식 비율"/>
                    <controls:KpiCard Label="보존식 완료율" Value="{Binding PreservationRate}" Sub="보존식 기록 완료 비율"/>
                    <controls:KpiCard Label="식단표 출력률" Value="{Binding MealPlanOutputRate}" Sub="식단표 출력 비율"/>
                    <controls:KpiCard Label="조리지시서 출력률" Value="{Binding CookingOutputRate}" Sub="조리지시서 출력 비율"/>
                    <controls:KpiCard Label="중식" Value="{Binding LunchSummary}" Sub="건수 · 완료율 요약"/>
                    <controls:KpiCard Label="석식" Value="{Binding DinnerSummary}" Sub="건수 · 완료율 요약"/>
                </StackPanel>

                <!-- Trend + Anomalies -->
                <Grid Grid.Row="1" Margin="0,0,0,16"
                      Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Monthly Trend -->
                    <Border Grid.Column="0" Style="{StaticResource StatisticsSection}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="월별 완료율 추세" Style="{StaticResource StatisticsSectionTitle}"/>
                            <TextBlock Text="실제 식수 입력" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                            <controls:BarChart ItemsSource="{Binding ActualInputTrend}" MinHeight="36" Margin="0,0,0,10"/>
                            <TextBlock Text="보존식 완료" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                            <controls:BarChart ItemsSource="{Binding PreservationTrend}" MinHeight="36" Margin="0,0,0,10"/>
                            <TextBlock Text="조리지시서 출력" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                            <controls:BarChart ItemsSource="{Binding CookingOutputTrend}" MinHeight="36"/>
                        </StackPanel>
                    </Border>

                    <!-- Anomalies -->
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource StatisticsSection}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="기록 누락" Style="{StaticResource StatisticsSectionTitle}"/>
                                <DataGrid ItemsSource="{Binding RecordGaps}"
                                          Style="{StaticResource CompactDataGrid}"
                                          IsReadOnly="True" MaxHeight="160">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="날짜" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                        <DataGridTextColumn Header="요일" Binding="{Binding Weekday}" Width="65"/>
                                        <DataGridTextColumn Header="구분" Binding="{Binding MealTypeName}" Width="55"/>
                                        <DataGridTextColumn Header="유형" Binding="{Binding Type}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource StatisticsSection}">
                            <StackPanel>
                                <TextBlock Text="지연 입력 (기록일 - 배식일 &gt; 1일)" Style="{StaticResource StatisticsSectionTitle}"/>
                                <DataGrid ItemsSource="{Binding LateInputs}"
                                          Style="{StaticResource CompactDataGrid}"
                                          IsReadOnly="True" MaxHeight="160">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="날짜" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                        <DataGridTextColumn Header="구분" Binding="{Binding MealTypeName}" Width="55"/>
                                        <DataGridTextColumn Header="계획" Binding="{Binding PlannedCount}" Width="60"/>
                                        <DataGridTextColumn Header="실제" Binding="{Binding ActualCount}" Width="60"/>
                                        <DataGridTextColumn Header="기록 시각" Binding="{Binding RecordedAt}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Preservation Analysis -->
                <Border Grid.Row="2" Style="{StaticResource StatisticsSection}" Margin="0,0,0,16"
                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="보존식 분석" Style="{StaticResource StatisticsSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding PreservationSummary}" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                <TextBlock Text="담당자별" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding PreservationByManager}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Style="{StaticResource RankingItem}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ManagerName}" Style="{StaticResource RankingLabel}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0}건}" Style="{StaticResource RankingValue}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <DataGrid Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding TemperatureRecords}"
                                      Style="{StaticResource CompactDataGrid}"
                                      IsReadOnly="True" MaxHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="날짜" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                    <DataGridTextColumn Header="구분" Binding="{Binding MealTypeName}" Width="55"/>
                                    <DataGridTextColumn Header="온도" Binding="{Binding Temperature}" Width="70"/>
                                    <DataGridTextColumn Header="담당자" Binding="{Binding ManagerName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Backdata -->
                <Border Grid.Row="3" Style="{StaticResource StatisticsSection}"
                        Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="백데이터" Style="{StaticResource StatisticsSectionTitle}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Text="{Binding BackdataFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Width="240" HorizontalAlignment="Left" Margin="0,0,0,8"
                                     Style="{StaticResource StandardTextBox}"
                                     ToolTip="날짜(yyyy-MM-dd)·구분·요일로 검색"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredBackdata}"
                                      Style="{StaticResource CompactDataGrid}"
                                      IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="날짜" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                                    <DataGridTextColumn Header="요일" Binding="{Binding Weekday}" Width="65"/>
                                    <DataGridTextColumn Header="구분" Binding="{Binding MealTypeName}" Width="55"/>
                                    <DataGridTextColumn Header="계획" Binding="{Binding PlannedCount}" Width="60"/>
                                    <DataGridTextColumn Header="실제" Binding="{Binding ActualCount}" Width="60"/>
                                    <DataGridTextColumn Header="실제 입력" Binding="{Binding ActualInput}" Width="70"/>
                                    <DataGridTextColumn Header="지연" Binding="{Binding ActualLate}" Width="50"/>
                                    <DataGridTextColumn Header="식단표" Binding="{Binding MealPlanOutput}" Width="60"/>
                                    <DataGridTextColumn Header="조리지시서" Binding="{Binding CookingOutput}" Width="70"/>
                                    <DataGridTextColumn Header="보존식" Binding="{Binding PreservationCompleted}" Width="60"/>
                                    <DataGridTextColumn Header="수거" Binding="{Binding PreservationCollected}" Width="50"/>
                                    <DataGridTextColumn Header="폐기" Binding="{Binding PreservationDisposed}" Width="50"/>
                                    <DataGridTextColumn Header="담당자" Binding="{Binding PreservationManager}" Width="80"/>
                                    <DataGridTextColumn Header="온도" Binding="{Binding PreservationTemperature}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status Bar -->
                <TextBlock Grid.Row="4" Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                           Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

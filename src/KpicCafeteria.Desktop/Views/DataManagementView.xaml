<UserControl x:Class="KpicCafeteria.Desktop.Views.DataManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KpicCafeteria.Desktop.ViewModels"
             xmlns:data="clr-namespace:KpicCafeteria.Application.DataManagement;assembly=KpicCafeteria.Application">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorder}">
            <TextBlock Style="{StaticResource PageTitleText}" Text="데이터 관리"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ===== Main Content ===== -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16" MaxWidth="700">

                <!-- ===== 데이터 가져오기 Section ===== -->
                <TextBlock Style="{StaticResource EditorSectionHeader}" Text="데이터 가져오기"/>
                <Border Style="{StaticResource OperationSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OperationDescription}"
                                   Text="기존 Excel 파일을 불러와 시스템으로 가져옵니다."/>

                        <!-- File picker -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource SubtleButton}" Command="{Binding BrowseImportCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconUpload}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Excel 파일 선택"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding SelectedImportPath}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="350" ToolTip="{Binding SelectedImportPath}"/>
                        </StackPanel>

                        <!-- Preview button -->
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding PreviewImportCommand}" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconEye}" Margin="0,0,6,0"/>
                                <TextBlock Text="미리보기"/>
                            </StackPanel>
                        </Button>

                        <!-- Preview result -->
                        <TextBlock Text="{Binding ImportPreviewText}" Style="{StaticResource BodyStrongText}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding IsImportReady, Converter={StaticResource BoolToVis}}"/>

                        <!-- Import mode + Apply -->
                        <TextBlock Style="{StaticResource FormFieldLabel}" Text="가져오기 방식"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,12">
                            <Button Style="{StaticResource SubtleButton}" Content="병합 (기존 데이터 유지)"
                                    Command="{Binding ApplyImportCommand}"
                                    CommandParameter="{x:Static data:ImportMode.Merge}"
                                    IsEnabled="{Binding IsImportReady}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource DestructiveButton}" Content="교체 (기존 데이터 초기화)"
                                    Command="{Binding ApplyImportCommand}"
                                    CommandParameter="{x:Static data:ImportMode.Replace}"
                                    IsEnabled="{Binding IsImportReady}"/>
                        </StackPanel>

                        <!-- Warning for Replace -->
                        <Border Style="{StaticResource WarningBanner}"
                                Visibility="{Binding IsImportReady, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconWarning}" Stroke="{StaticResource WarningBrush}" Margin="0,0,6,0"/>
                                <TextBlock Style="{StaticResource WarningBannerText}"
                                           Text="교체 방식은 기존 데이터가 모두 초기화됩니다. 실행 전 자동 백업이 생성됩니다."/>
                            </StackPanel>
                        </Border>

                        <!-- Errors / warnings -->
                        <TextBox Text="{Binding ImportStatus}" IsReadOnly="True" TextWrapping="Wrap"
                                 Height="80" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                                 Margin="0,8,0,0"
                                 Visibility="{Binding IsImportReady, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- ===== 시스템 백업 Section ===== -->
                <TextBlock Style="{StaticResource EditorSectionHeader}" Text="시스템 백업"/>
                <Border Style="{StaticResource OperationSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OperationDescription}"
                                   Text="현재 시스템의 모든 업무 데이터를 복구 가능한 파일로 저장합니다."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateBackupCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconSave}" Margin="0,0,6,0" Stroke="White"/>
                                    <TextBlock Text="백업 만들기"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" Command="{Binding LoadBackupsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconRefresh}" Margin="0,0,6,0"/>
                                    <TextBlock Text="목록 새로고침"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Backup list -->
                        <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                                  Style="{StaticResource CompactDataGrid}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  RowHeaderWidth="0" SelectionMode="Single"
                                  MaxHeight="180"
                                  ColumnHeaderStyle="{StaticResource FlatDataGridColumnHeader}"
                                  CellStyle="{StaticResource FlatDataGridCell}"
                                  RowStyle="{StaticResource FlatDataGridRow}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="파일명" Binding="{Binding Filename}" Width="*"/>
                                <DataGridTextColumn Header="유형" Binding="{Binding BackupType}" Width="80"/>
                                <DataGridTextColumn Header="생성일" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== 시스템 복구 Section ===== -->
                <TextBlock Style="{StaticResource EditorSectionHeader}" Text="시스템 복구"/>
                <Border Style="{StaticResource OperationSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OperationDescription}"
                                   Text="기존 백업 파일을 사용하여 시스템 데이터를 복구합니다."/>

                        <Border Style="{StaticResource WarningBanner}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconWarning}" Stroke="{StaticResource WarningBrush}" Margin="0,0,6,0"/>
                                <TextBlock Style="{StaticResource WarningBannerText}"
                                           Text="복구 시 현재 데이터가 변경됩니다. 복구 전 자동으로 사전 백업이 생성됩니다."/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource DestructiveButton}" Content="복구 시작"
                                    Command="{Binding RestoreBackupCommand}"
                                    IsEnabled="{Binding SelectedBackup}"/>
                            <TextBlock Style="{StaticResource CaptionText}" Text="위 백업 목록에서 복구할 파일을 선택하세요"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Excel 아카이브 Section ===== -->
                <TextBlock Style="{StaticResource EditorSectionHeader}" Text="Excel 아카이브"/>
                <Border Style="{StaticResource OperationSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OperationDescription}"
                                   Text="업무 데이터를 사람이 확인할 수 있는 Excel 파일로 저장합니다. 시스템 복구용이 아닙니다."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FormFieldLabel}" Text="기간"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker SelectedDate="{Binding ArchiveStartDate}" Width="130" Margin="0,0,4,0"/>
                            <TextBlock Text="~" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <DatePicker SelectedDate="{Binding ArchiveEndDate}" Width="130" Margin="0,0,16,0"/>
                            <Button Style="{StaticResource SubtleButton}" Content="Excel 아카이브 생성"
                                    Command="{Binding BrowseArchiveCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding ArchiveStatus}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ===== Progress ===== -->
                <Border Style="{StaticResource ProgressPanel}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="처리 중..." Style="{StaticResource BodyText}"
                               Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

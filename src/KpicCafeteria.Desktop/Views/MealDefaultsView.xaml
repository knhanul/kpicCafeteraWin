<UserControl x:Class="KpicCafeteria.Desktop.Views.MealDefaultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KpicCafeteria.Desktop.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorder}">
            <DockPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="배식 기본값"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ===== Settings Form ===== -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16" MaxWidth="600">

                <!-- Rows -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DetailSectionBorder}">
                                <StackPanel>
                                    <!-- Meal type name -->
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16"/>

                                    <!-- 기본 식수 -->
                                    <TextBlock Style="{StaticResource FormFieldLabel}" Text="기본 식수"/>
                                    <TextBox Style="{StaticResource StandardTextBox}"
                                             Text="{Binding DefaultPlannedCount, UpdateSourceTrigger=PropertyChanged}"
                                             MaxWidth="120" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                                    <!-- 배식 시간 -->
                                    <TextBlock Style="{StaticResource FormFieldLabel}" Text="배식 시간 (HH:mm~HH:mm)"/>
                                    <TextBox Style="{StaticResource StandardTextBox}"
                                             Text="{Binding DefaultServiceTime, UpdateSourceTrigger=PropertyChanged}"
                                             MaxWidth="200" HorizontalAlignment="Left" Margin="0,0,0,12"
                                             ToolTip="예: 11:30~13:00"/>

                                    <!-- 순서 -->
                                    <TextBlock Style="{StaticResource FormFieldLabel}" Text="정렬 순서"/>
                                    <TextBox Style="{StaticResource StandardTextBox}"
                                             Text="{Binding SortOrder, UpdateSourceTrigger=PropertyChanged}"
                                             MaxWidth="80" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                                    <!-- 설명 -->
                                    <TextBlock Style="{StaticResource FormFieldLabel}" Text="설명"/>
                                    <TextBox Style="{StaticResource StandardTextBox}"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             MaxWidth="400" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                                    <!-- 사용 여부 -->
                                    <CheckBox Style="{StaticResource StandardCheckBox}" Content="사용"
                                              IsChecked="{Binding IsActive}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Action Bar ===== -->
        <Border Grid.Row="2" Style="{StaticResource DetailActionBar}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconSave}" Margin="0,0,6,0" Stroke="White"/>
                        <TextBlock Text="저장"/>
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource CaptionText}" Text="배식 기본값은 저장 시 즉시 반영됩니다"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

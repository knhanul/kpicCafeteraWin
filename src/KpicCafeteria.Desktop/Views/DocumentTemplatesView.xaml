<UserControl x:Class="KpicCafeteria.Desktop.Views.DocumentTemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KpicCafeteria.Desktop.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorder}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RegisterCommand}" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconPlus}" Margin="0,0,6,0" Stroke="White"/>
                        <TextBlock Text="양식 등록"/>
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource PageTitleText}" Text="문서 양식 관리"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ===== DataGrid ===== -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  Style="{StaticResource CompactDataGrid}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  ColumnHeaderStyle="{StaticResource FlatDataGridColumnHeader}"
                  CellStyle="{StaticResource FlatDataGridCell}"
                  RowStyle="{StaticResource FlatDataGridRow}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="문서 유형" Binding="{Binding DocumentTypeName}" Width="110"/>
                <DataGridTextColumn Header="양식명" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="버전" Binding="{Binding Version}" Width="60"/>
                <DataGridTextColumn Header="상태" Binding="{Binding StatusDisplay}" Width="70"/>
                <DataGridTextColumn Header="크기" Binding="{Binding FileSizeDisplay}" Width="90"/>
                <DataGridTextColumn Header="원본 파일" Binding="{Binding OriginalFilename}" Width="1.2*"/>
                <DataGridTextColumn Header="등록일" Binding="{Binding CreatedAtDisplay}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== Action Bar ===== -->
        <Border Grid.Row="2" Style="{StaticResource DetailActionBar}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DestructiveButton}"
                        Command="{Binding DeleteCommand}" Content="삭제" Margin="8,0,0,0"
                        Visibility="{Binding SelectedRow, Converter={StaticResource NullToVis}}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}"
                        Command="{Binding RestoreDefaultCommand}" Content="기본 양식 복원" Margin="8,0,0,0"
                        Visibility="{Binding SelectedRow, Converter={StaticResource NullToVis}}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ActivateCommand}" Content="활성화" Margin="0,0,0,0"
                        Visibility="{Binding SelectedRow, Converter={StaticResource NullToVis}}"/>
                <TextBlock Style="{StaticResource CaptionText}"
                           Text="유형별 활성 양식이 문서 출력에 사용됩니다."
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="KpicCafeteria.Desktop.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KpicCafeteria.Desktop.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:SaveStatusToBrushConverter x:Key="SaveStatusBrush"/>
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <vm:NullToVisibilityConverter x:Key="NullToVis"/>
        <vm:NullToCollapsedVisibilityConverter x:Key="NullToCollapsedVis"/>
        <ObjectDataProvider x:Key="StatusOptions" ObjectType="{x:Type vm:OrderStatusOption}" MethodName="GetAll"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Top Toolbar ===== -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarBorder}">
            <DockPanel>
                <!-- Save button (right) -->
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IconSave}" Margin="0,0,6,0" Stroke="White"/>
                        <TextBlock Text="저장"/>
                    </StackPanel>
                </Button>

                <!-- Save status (right) -->
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource SaveStatusBadge}"
                           Text="{Binding SaveStatusText}"
                           Foreground="{Binding SaveStatusColor, Converter={StaticResource SaveStatusBrush}}"
                           Margin="16,0,0,0"/>

                <!-- Period selector (right) -->
                <ComboBox DockPanel.Dock="Right" Style="{StaticResource StandardComboBox}"
                          Width="90" Margin="12,0,0,0"
                          ItemsSource="{Binding PeriodOptions}"
                          SelectedItem="{Binding SelectedPeriod}"
                          DisplayMemberPath="Label" VerticalAlignment="Center"/>

                <!-- Period label (left) -->
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleText}"
                           Text="{Binding PeriodLabel}" Margin="16,0,0,0" VerticalAlignment="Center"/>

                <!-- Nav arrows (left) -->
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource NavArrowButton}" Command="{Binding QueryCommand}" Content="‹ 조회"/>
                </StackPanel>

                <!-- Title -->
                <TextBlock Style="{StaticResource PageTitleText}" Text="발주"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <!-- ===== Main Content ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left: Filter Bar + DataGrid ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Bar -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceSecondaryBrush}" Padding="12,8">
                    <DockPanel>
                        <!-- Select all (right) -->
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource StandardCheckBox}"
                                  Content="전체 선택" IsChecked="{Binding AllSelected}" VerticalAlignment="Center" Margin="12,0,0,0"/>

                        <!-- Sort (right) -->
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource StandardComboBox}"
                                  Width="100" Margin="12,0,0,0"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}"
                                  DisplayMemberPath="Label" VerticalAlignment="Center"/>

                        <!-- View mode toggle (left) -->
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="재료별" IsChecked="{Binding IsByIngredient}" GroupName="ViewMode"
                                         VerticalAlignment="Center" Margin="0,0,12,0"
                                         FontFamily="{StaticResource AppFontFamily}" FontSize="12"/>
                            <RadioButton Content="사용일별" IsChecked="{Binding IsByDate}" GroupName="ViewMode"
                                         VerticalAlignment="Center" Margin="0,0,20,0"
                                         FontFamily="{StaticResource AppFontFamily}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Selection Action Bar -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="12,6"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SubtleButton}" Content="묶음 발주"
                                    Command="{Binding GroupOrderCommand}" Margin="8,0,0,0"/>
                            <Button Style="{StaticResource SubtleButton}" Content="일괄 변경"
                                    Command="{Binding BulkUpdateCommand}" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Text="{Binding SelectedCount, StringFormat={}{0}개 선택}"/>
                    </DockPanel>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="2" Style="{StaticResource CompactDataGrid}"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0" SelectionMode="Single"
                          IsReadOnly="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          ColumnHeaderStyle="{StaticResource FlatDataGridColumnHeader}"
                          CellStyle="{StaticResource FlatDataGridCell}"
                          RowStyle="{StaticResource FlatDataGridRow}">
                    <DataGrid.Columns>
                        <!-- 선택 -->
                        <DataGridTemplateColumn Header="✓" Width="36" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 재료 -->
                        <DataGridTemplateColumn Header="재료" Width="120" SortMemberPath="IngredientName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IngredientName}" Style="{StaticResource BodyStrongText}"/>
                                        <TextBlock Text="{Binding InPlanLabel}" FontSize="10" Foreground="{StaticResource WarningBrush}"
                                                   Visibility="{Binding InPlan, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 사용일 -->
                        <DataGridTextColumn Header="사용일" Width="60" IsReadOnly="True"
                                            Binding="{Binding ServiceDateLabel}"/>

                        <!-- 사용 메뉴 -->
                        <DataGridTemplateColumn Header="사용 메뉴" Width="140" SortMemberPath="SourceMenusDisplay">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SourceMenusDisplay}" Style="{StaticResource CaptionText}"
                                               ToolTip="{Binding SourceMenusTooltip}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 필요량 -->
                        <DataGridTextColumn Header="필요량" Width="80" IsReadOnly="True"
                                            Binding="{Binding RequiredDisplay}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 추천량 -->
                        <DataGridTemplateColumn Header="추천량" Width="90" SortMemberPath="SuggestedOrderQuantity">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SuggestedDisplay}" Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               ToolTip="포장단위 확인 필요 시 직접 입력하세요"
                                               HorizontalAlignment="Right" Padding="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 발주량 -->
                        <DataGridTemplateColumn Header="발주량" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="60" FontSize="12" Padding="4,2"
                                                 Text="{Binding OrderQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                        <TextBox Width="40" FontSize="12" Padding="4,2" Margin="4,0,0,0"
                                                 Text="{Binding OrderUnit, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 상태 -->
                        <DataGridTemplateColumn Header="상태" Width="90" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource StatusOptions}}"
                                              SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Code" DisplayMemberPath="Label"
                                              FontSize="11" Padding="4,2" MinHeight="0"
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 비고 -->
                        <DataGridTemplateColumn Header="비고" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding OrderNote, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" FontSize="12" Padding="4,0"
                                             VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ===== Right: Detail Panel ===== -->
            <Border Grid.Column="1" Style="{StaticResource EditorPanelBorder}">
                <ScrollViewer Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12">

                        <!-- Detail: visible when item selected -->
                        <StackPanel Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}">
                            <!-- Ingredient name -->
                            <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding SelectedItem.IngredientName}" Margin="0,0,0,16"/>

                            <!-- Service date -->
                            <TextBlock Style="{StaticResource EditorFieldLabel}" Text="사용일"/>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding SelectedItem.ServiceDateLabel}" Margin="0,0,0,12"/>

                            <!-- Source menus -->
                            <TextBlock Style="{StaticResource EditorSectionHeader}" Text="사용 메뉴"/>
                            <ItemsControl ItemsSource="{Binding SelectedSourceMenus}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding ServiceDate, StringFormat={}{0:M/d}}" Width="40" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding MealTypeName}" Width="40" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding MenuName}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Required -->
                            <TextBlock Style="{StaticResource EditorFieldLabel}" Text="필요량"/>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding SelectedItem.RequiredDisplay}" Margin="0,0,0,12"/>

                            <!-- Package -->
                            <TextBlock Style="{StaticResource EditorFieldLabel}" Text="판매단위"/>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding SelectedItem.PackageDisplay}" Margin="0,0,0,12"/>

                            <!-- Suggested -->
                            <TextBlock Style="{StaticResource EditorFieldLabel}" Text="추천 발주량"/>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding SelectedItem.SuggestedDisplay}"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                            <!-- Order quantity -->
                            <TextBlock Style="{StaticResource EditorFieldLabel}" Text="발주량"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox Style="{StaticResource StandardTextBox}" Width="80"
                                         Text="{Binding SelectedItem.OrderQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Style="{StaticResource StandardTextBox}" Width="50" Margin="4,0,0,0"
                                         Text="{Binding SelectedItem.OrderUnit, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Order date -->
                            <TextBlock Style="{StaticResource EditorFieldLabel}" Text="발주일"/>
                            <DatePicker Style="{StaticResource StandardDatePicker}"
                                        SelectedDate="{Binding SelectedItem.OrderDate}" Margin="0,0,0,12"/>

                            <!-- Delivery date -->
                            <TextBlock Style="{StaticResource EditorFieldLabel}" Text="배송일"/>
                            <DatePicker Style="{StaticResource StandardDatePicker}"
                                        SelectedDate="{Binding SelectedItem.DeliveryDate}" Margin="0,0,0,12"/>

                            <!-- Status -->
                            <TextBlock Style="{StaticResource EditorFieldLabel}" Text="상태"/>
                            <ComboBox Style="{StaticResource StandardComboBox}"
                                      ItemsSource="{Binding Source={StaticResource StatusOptions}}"
                                      SelectedValue="{Binding SelectedItem.Status, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Code" DisplayMemberPath="Label" Margin="0,0,0,12"/>

                            <!-- Note -->
                            <TextBlock Style="{StaticResource EditorFieldLabel}" Text="메모"/>
                            <TextBox Style="{StaticResource StandardTextBox}" TextWrapping="Wrap"
                                     Text="{Binding SelectedItem.OrderNote, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="60" Margin="0,0,0,12"/>

                            <!-- Group display -->
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding SelectedItem.GroupDisplay}"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"
                                       Visibility="{Binding SelectedItem.OrderGroupId, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>

                        <!-- Empty state -->
                        <StackPanel Visibility="{Binding SelectedItem, Converter={StaticResource NullToCollapsedVis}}">
                            <TextBlock Style="{StaticResource EmptyStateText}" Text="항목을 선택하면 상세 정보가 표시됩니다"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

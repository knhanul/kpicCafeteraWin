<UserControl x:Class="KpicCafeteria.Desktop.Controls.BarChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KpicCafeteria.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <controls:PercentToGridLengthConverter x:Key="PercentToGridLengthConverter"/>
    </UserControl.Resources>
    <ItemsControl ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Column="1" Height="16" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentToGridLengthConverter}}"/>
                            <ColumnDefinition Width="{Binding Remainder, Converter={StaticResource PercentToGridLengthConverter}}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding Color}" CornerRadius="4" Margin="0,0,2,0"/>
                        <Border Grid.Column="1" Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="4"/>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Day Card (column in the weekly board) ===== -->
    <Style x:Key="DayCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="DayCardHeader" TargetType="Border">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- Today header variant -->
    <Style x:Key="DayCardHeaderToday" TargetType="Border" BasedOn="{StaticResource DayCardHeader}">
        <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- ===== Service Card (중식/석식 button in day card) ===== -->
    <Style x:Key="ServiceCardButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="6,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ServiceBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ServiceBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            <Setter TargetName="ServiceBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ServiceBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="ServiceBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selected service card variant -->
    <Style x:Key="ServiceCardButtonSelected" TargetType="Button" BasedOn="{StaticResource ServiceCardButton}">
        <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- ===== Meal Type Label ===== -->
    <Style x:Key="MealTypeLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <!-- ===== Menu Summary Text ===== -->
    <Style x:Key="MenuSummaryText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- ===== Status Badge ===== -->
    <Style x:Key="StatusBadge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- ===== Add Service Button ===== -->
    <Style x:Key="AddServiceButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Margin" Value="6,2,6,8"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="AddBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="AddBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            <Setter TargetName="AddBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Editor Section Header ===== -->
    <Style x:Key="EditorSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>

    <!-- ===== Editor Field Label ===== -->
    <Style x:Key="EditorFieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>

    <!-- ===== Save Status Badge ===== -->
    <Style x:Key="SaveStatusBadge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Empty State Text ===== -->
    <Style x:Key="EmptyStateText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <!-- ===== Week Separator ===== -->
    <Style x:Key="WeekSeparator" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="Margin" Value="4,8,4,4"/>
    </Style>

    <!-- ===== Week Label ===== -->
    <Style x:Key="WeekLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="8,0,0,4"/>
    </Style>

    <!-- ===== Toolbar Border ===== -->
    <Style x:Key="ToolbarBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

    <!-- ===== Editor Panel Border ===== -->
    <Style x:Key="EditorPanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>

    <!-- ===== Cooking Row Border ===== -->
    <Style x:Key="CookingRowBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ===== Focus Mode: Compact Toolbar ===== -->
    <Style x:Key="FocusToolbarBorder" TargetType="Border" BasedOn="{StaticResource ToolbarBorder}">
        <Setter Property="Padding" Value="16,8"/>
    </Style>

    <!-- ===== Focus Mode: Day Header Cell ===== -->
    <Style x:Key="FocusDayHeaderCell" TargetType="Border">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style x:Key="FocusDayHeaderCellToday" TargetType="Border" BasedOn="{StaticResource FocusDayHeaderCell}">
        <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- ===== Focus Mode: Meal Section Header ===== -->
    <Style x:Key="FocusMealSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>

    <!-- ===== Focus Mode: Menu Cell (day column within a meal section) ===== -->
    <Style x:Key="FocusMenuCell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- ===== Focus Mode: Menu Row (individual menu item) ===== -->
    <Style x:Key="FocusMenuRow" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <!-- ===== Focus Mode: Empty Cell ===== -->
    <Style x:Key="FocusEmptyCell" TargetType="Border" BasedOn="{StaticResource FocusMenuCell}">
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
    </Style>

    <!-- ===== Focus Mode: Add Menu Button ===== -->
    <Style x:Key="FocusAddMenuButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- ===== Focus Mode: Editor Overlay ===== -->
    <Style x:Key="FocusEditorOverlay" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Width" Value="420"/>
    </Style>

    <!-- ===== Master Data: List Container ===== -->
    <Style x:Key="MasterListContainer" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <!-- ===== Master Data: List Item (flat, hover, selected) ===== -->
    <Style x:Key="MasterListItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="3,0,0,1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Master Data: Detail Section Border ===== -->
    <Style x:Key="DetailSectionBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,0,0,16"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- ===== Master Data: Form Field Label ===== -->
    <Style x:Key="FormFieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ===== Master Data: Alias Chip ===== -->
    <Style x:Key="AliasChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>

    <!-- ===== Master Data: Alias Chip Close Button ===== -->
    <Style x:Key="AliasChipClose" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="MinWidth" Value="16"/>
        <Setter Property="MinHeight" Value="16"/>
    </Style>

    <!-- ===== Master Data: Destructive Button ===== -->
    <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <!-- ===== Master Data: Detail Action Bar ===== -->
    <Style x:Key="DetailActionBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

    <!-- ===== Operation Section (data management, document output) ===== -->
    <Style x:Key="OperationSection" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,0,0,20"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <!-- ===== Operation Description ===== -->
    <Style x:Key="OperationDescription" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ===== Warning Banner ===== -->
    <Style x:Key="WarningBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        <Setter Property="Opacity" Value="0.12"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ===== Warning Banner Text ===== -->
    <Style x:Key="WarningBannerText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ===== Progress Panel ===== -->
    <Style x:Key="ProgressPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- ===== Result Summary ===== -->
    <Style x:Key="ResultSummary" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="Opacity" Value="0.12"/>
        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- ===== Result Summary Text ===== -->
    <Style x:Key="ResultSummaryText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ===== Statistics: Section Container ===== -->
    <Style x:Key="StatisticsSection" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- ===== Statistics: Section Title ===== -->
    <Style x:Key="StatisticsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ===== Statistics: Anomaly Item ===== -->
    <Style x:Key="AnomalyItem" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        <Setter Property="Opacity" Value="0.1"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ===== Statistics: Anomaly Text ===== -->
    <Style x:Key="AnomalyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ===== Statistics: Empty State ===== -->
    <Style x:Key="StatisticsEmptyState" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,24"/>
    </Style>

    <!-- ===== Dialog: Title ===== -->
    <Style x:Key="DialogTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== Dialog: Field Label ===== -->
    <Style x:Key="DialogFieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ===== Statistics: Toolbar ===== -->
    <Style x:Key="StatisticsToolbar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

    <!-- ===== Statistics: Period Display ===== -->
    <Style x:Key="PeriodDisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== Statistics: Loading Overlay ===== -->
    <Style x:Key="LoadingOverlay" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Opacity" Value="0.8"/>
    </Style>

    <!-- ===== Statistics: Ranking Item ===== -->
    <Style x:Key="RankingItem" TargetType="Grid">
        <Setter Property="Margin" Value="0,3"/>
    </Style>

    <!-- ===== Statistics: Ranking Label ===== -->
    <Style x:Key="RankingLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ===== Statistics: Ranking Value ===== -->
    <Style x:Key="RankingValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- ===== Statistics: Detail Panel ===== -->
    <Style x:Key="DetailPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

</ResourceDictionary>
